@model IEnumerable<PAW.Models.DTO.NotificationDTO>

@{
    ViewData["Title"] = "Notification Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Notifications</h2>

        <button class="btn btn-primary btn-crud"
                data-url="@Url.Action(
                                "Create",
                                "Notification")">

            <i class="bi bi-plus-circle"></i>

            Add Notification

        </button>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>ID</th>
                            <th>User ID</th>
                            <th>Message</th>
                            <th>Status</th>
                            <th>Created At</th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null &&
                             Model.Any())
                        {
                            foreach (
                                var notification
                                in Model)
                            {
                                <tr>

                                    <td>
                                        @notification.Id
                                    </td>


                                    <td>
                                        @notification.UserId
                                    </td>


                                    <td>

                                        @notification.Message

                                    </td>


                                    <td>

                                        @if (
                                            notification.IsRead
                                            == true)
                                        {
                                            <span class="badge bg-success">
                                                Read
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Unread
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @notification
                                        .CreatedAt?
                                        .ToString(
                                        "yyyy-MM-dd HH:mm")

                                    </td>


                                    <td class="text-center">

                                        <div class="btn-group"
                                             role="group">


                                            <button class="btn btn-sm btn-warning btn-crud"
                                                    data-url="@Url.Action(
                                                                                                        "Edit",
                                                                                                        "Notification",
                                                                                                        new
                                                                                                        {
                                                                                                            id =
                                                                                                                notification.Id
                                                                                                        })">

                                                Edit

                                            </button>


                                            <button class="btn btn-sm btn-info text-white btn-crud"
                                                    data-url="@Url.Action(
                                                                                                        "Details",
                                                                                                        "Notification",
                                                                                                        new
                                                                                                        {
                                                                                                            id =
                                                                                                                notification.Id
                                                                                                        })">

                                                Details

                                            </button>


                                            <button class="btn btn-sm btn-danger btn-crud"
                                                    data-url="@Url.Action(
                                                                                                        "Delete",
                                                                                                        "Notification",
                                                                                                        new
                                                                                                        {
                                                                                                            id =
                                                                                                                notification.Id
                                                                                                        })">

                                                Delete

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center">

                                    No notifications found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>


                @{
                    int currentPage =
                        ViewBag.CurrentPage;

                    int totalPages =
                        ViewBag.TotalPages;
                }


                @if (totalPages > 1)
                {
                    <nav aria-label="Notification pagination">

                        <ul class="pagination justify-content-center">


                            <!-- FIRST -->
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="1">

                                    First

                                </a>

                            </li>


                            <!-- PREVIOUS -->
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage - 1)">

                                    Previous

                                </a>

                            </li>


                            <!-- FIRST PAGE -->
                            <li class="page-item @(currentPage == 1 ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="1">

                                    1

                                </a>

                            </li>


                            <!-- LEFT ELLIPSIS -->
                            @if (currentPage > 3)
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        ...
                                    </span>

                                </li>
                            }


                            @{
                                int startPage =
                                    Math.Max(
                                        2,
                                        currentPage - 1);

                                int endPage =
                                    Math.Min(
                                        totalPages - 1,
                                        currentPage + 1);
                            }


                            <!-- PREVIOUS / CURRENT / NEXT -->
                            @for (
                                int i = startPage;
                                i <= endPage;
                                i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i">

                                        @i

                                    </a>

                                </li>
                            }


                            <!-- RIGHT ELLIPSIS -->
                            @if (
                                currentPage <
                                totalPages - 2)
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        ...
                                    </span>

                                </li>
                            }


                            <!-- LAST PAGE -->
                            @if (totalPages > 1)
                            {
                                <li class="page-item @(currentPage == totalPages ? "active" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@totalPages">

                                        @totalPages

                                    </a>

                                </li>
                            }


                            <!-- NEXT -->
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage + 1)">

                                    Next

                                </a>

                            </li>


                            <!-- LAST -->
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@totalPages">

                                    Last

                                </a>

                            </li>

                        </ul>

                    </nav>
                }

            </div>

        </div>

    </div>

</div>