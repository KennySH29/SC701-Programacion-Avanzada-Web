@model IEnumerable<PAW.Models.DTO.ProductDTO>
@{
    ViewData["Title"] = "Product Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Products</h2>

        <!-- Modificado: De enlace de redirección a botón CRUD con data-url -->
        <button class="btn btn-primary btn-crud" data-url="@Url.Action("Create", "Product")">
            <i class="bi bi-plus-circle"></i>
            Add Product
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Product ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Rating</th>
                            <th>Created By</th>
                            <th>Modified By</th>
                            <th>Modified Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var product in Model)
                            {
                                <tr>

                                    <td>
                                        @product.ProductId
                                    </td>

                                    <td>
                                        <strong>@product.Name</strong>
                                    </td>

                                    <td>
                                        @product.Description
                                    </td>

                                    <td>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= product.Rating)
                                            {
                                                <span class="text-warning">★</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">☆</span>
                                            }
                                        }
                                    </td>

                                    <td>
                                        @product.CreatedBy
                                    </td>

                                    <td>
                                        @product.ModifiedBy
                                    </td>

                                    <td>
                                        @product.ModifiedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Modificado: Edit (Ahora es botón interactivo) -->
                                            <button class="btn btn-sm btn-warning btn-crud"
                                                    data-url="@Url.Action("Edit", "Product", new { id = product.ProductId })">
                                                Edit
                                            </button>

                                            <!-- Modificado: Details (Ahora es botón interactivo) -->
                                            <button class="btn btn-sm btn-info text-white btn-crud"
                                                    data-url="@Url.Action("Details", "Product", new { id = product.ProductId })">
                                                Details
                                            </button>

                                            <!-- Modificado: Delete (Ahora es botón interactivo) -->
                                            <button class="btn btn-sm btn-danger btn-crud"
                                                    data-url="@Url.Action("Delete", "Product", new { id = product.ProductId })">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center">
                                    No products found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

                @{
                    int currentPage = ViewBag.CurrentPage;
                    int totalPages = ViewBag.TotalPages;
                }

                @if (totalPages > 1)
                {
                    <nav aria-label="Product pagination">
                        <ul class="pagination justify-content-center">

                            <!-- FIRST -->
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="1">
                                    First
                                </a>
                            </li>

                            <!-- PREVIOUS -->
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage - 1)">
                                    Previous
                                </a>
                            </li>


                            <!-- PRIMERA PÁGINA -->
                            <li class="page-item @(currentPage == 1 ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="1">
                                    1
                                </a>
                            </li>


                            <!-- ... ANTES DE LA PÁGINA ACTUAL -->
                            @if (currentPage > 3)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }


                            @{
                                int startPage =
                                    Math.Max(2, currentPage - 1);

                                int endPage =
                                    Math.Min(totalPages - 1, currentPage + 1);
                            }


                            <!-- ANTERIOR / ACTUAL / SIGUIENTE -->
                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i">
                                        @i
                                    </a>
                                </li>
                            }


                            <!-- ... DESPUÉS DE LA PÁGINA ACTUAL -->
                            @if (currentPage < totalPages - 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }


                            <!-- ÚLTIMA PÁGINA -->
                            @if (totalPages > 1)
                            {
                                <li class="page-item @(currentPage == totalPages ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@totalPages">
                                        @totalPages
                                    </a>
                                </li>
                            }


                            <!-- NEXT -->
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage + 1)">
                                    Next
                                </a>
                            </li>


                            <!-- LAST -->
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@totalPages">
                                    Last
                                </a>
                            </li>

                        </ul>
                    </nav>
                }

            </div>

        </div>
    </div>

</div>

