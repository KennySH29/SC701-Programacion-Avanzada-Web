@model PAW.Models.DTO.NotificationDTO

<form asp-action="DeleteConfirmed"
      method="post"
      id="formDeleteNotification">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="id"
           value="@Model.Id" />


    <div class="modal-body text-center py-4">

        <div class="text-danger mb-3">

            <svg xmlns="http://www.w3.org/2000/svg"
                 width="48"
                 height="48"
                 fill="currentColor"
                 class="bi bi-exclamation-triangle"
                 viewBox="0 0 16 16">

                <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.15.15 0 0 1 .054.057l6.857 11.667c.033.059.033.123.002.183a.2.2 0 0 1-.054.06c-.01.006-.017.01-.028.007h-13.74a.2.2 0 0 1-.03-.007.2.2 0 0 1-.053-.06.18.18 0 0 1 .002-.183L7.884 2.073a.15.15 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767z" />

                <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z" />

            </svg>

        </div>


        <p class="fs-5 m-0">

            Are you sure you want to delete
            notification

            <strong>
                #@Model.Id
            </strong>?

        </p>


        <div class="mt-3 p-3 bg-light rounded">

            <strong>Message:</strong>

            <br />

            @Model.Message

        </div>


        <small class="text-muted d-block mt-3">
            This action cannot be undone.
        </small>

    </div>


    <div class="modal-footer justify-content-center">

        <button type="button"
                class="btn btn-secondary px-4"
                data-bs-dismiss="modal">

            Cancel

        </button>

        <button type="submit"
                class="btn btn-danger px-4">

            Delete

        </button>

    </div>

</form>