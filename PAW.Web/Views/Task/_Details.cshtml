@model PAW.Models.DTO.TaskDTO

<div class="modal-body p-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <span class="text-muted small text-uppercase">
                Technical Sheet
            </span>

            <h4 class="fw-bold m-0 text-primary">
                @Model.Name
            </h4>

        </div>

        <span class="badge bg-light text-dark border p-2">
            ID: #@Model.Id
        </span>

    </div>


    <div class="table-responsive bg-white rounded border p-2">

        <table class="table table-sm table-borderless align-middle m-0">

            <tbody>

                <tr>
                    <td class="text-muted">
                        Task ID
                    </td>

                    <td class="fw-semibold">
                        @Model.Id
                    </td>
                </tr>

                <tr>
                    <td class="text-muted">
                        Name
                    </td>

                    <td class="fw-semibold">
                        @Model.Name
                    </td>
                </tr>

                <tr>
                    <td class="text-muted">
                        Description
                    </td>

                    <td>
                        @Model.Description
                    </td>
                </tr>

                <tr>
                    <td class="text-muted">
                        Status
                    </td>

                    <td>
                        @Model.Status
                    </td>
                </tr>

                <tr>
                    <td class="text-muted">
                        Due Date
                    </td>

                    <td>
                        @Model.DueDate?.ToString(
                            "yyyy-MM-dd HH:mm")
                    </td>
                </tr>

                <tr>
                    <td colspan="2">
                        <hr class="text-muted opacity-25 my-2" />
                    </td>
                </tr>

                <tr>
                    <td class="text-muted">
                        Created At
                    </td>

                    <td class="small">
                        @Model.CreatedAt?.ToString(
                            "yyyy-MM-dd HH:mm")
                    </td>
                </tr>

                <tr>
                    <td class="text-muted">
                        Last Modified
                    </td>

                    <td class="small">
                        @Model.LastModified?.ToString(
                            "yyyy-MM-dd HH:mm")
                    </td>
                </tr>

                <tr>
                    <td class="text-muted">
                        Modified By
                    </td>

                    <td class="small">
                        @Model.ModifiedBy
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>


<div class="modal-footer">

    <button type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">
        Close
    </button>

    <button type="button"
            class="btn btn-dark btn-switch-to-edit"
            data-url="@Url.Action(
                        "Edit",
                        "Task",
                        new { id = Model.Id })">
        Edit Task
    </button>

</div>
