@model PAW.Models.DTO.ProductDTO

<form asp-action="DeleteConfirmed" method="post" id="formDeleteProduct">
    @Html.AntiForgeryToken()
    <!-- Campo oculto para mapear el ID del producto que se va a borrar -->
    <input type="hidden" name="id" value="@Model.ProductId" />

    <div class="modal-body text-center py-4">
        <!-- Icono de advertencia opcional para mejorar la interfaz visual -->
        <div class="text-danger mb-3">
            <svg xmlns="http://w3.org" width="48" height="48" fill="currentColor" class="bi bi-exclamation-triangle" viewBox="0 0 16 16">
                <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.15.15 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.2.2 0 0 1-.054.06c-.01.006-.017.01-.028.007h-13.74a.2.2 0 0 1-.03-.007.2.2 0 0 1-.053-.06.18.18 0 0 1 .002-.183L7.884 2.073a.15.15 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767z" />
                <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z" />
            </svg>
        </div>
        <p class="fs-5 m-0">
            Are you sure you want to delete <br />
            <strong class="text-dark">@Model.Name</strong>?
        </p>
        <small class="text-muted">This action cannot be undone.</small>
    </div>

    <div class="modal-footer justify-content-center">
        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger px-4">Delete</button>
    </div>
</form>


