@model PAW.Models.DTO.NotificationDTO

<form asp-action="Edit"
      method="post"
      id="formEditNotification">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="Id" />


    <div class="modal-body">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <div class="mb-3">

            <label asp-for="UserId"
                   class="form-label">
                User ID
            </label>

            <input asp-for="UserId"
                   type="number"
                   class="form-control" />

            <span asp-validation-for="UserId"
                  class="text-danger">
            </span>

        </div>


        <div class="mb-3">

            <label asp-for="Message"
                   class="form-label">
                Message
            </label>

            <textarea asp-for="Message"
                      class="form-control"
                      rows="4"
                      maxlength="255">
            </textarea>

            <span asp-validation-for="Message"
                  class="text-danger">
            </span>

        </div>


        <div class="form-check mb-3">

            <input asp-for="IsRead"
                   class="form-check-input" />

            <label asp-for="IsRead"
                   class="form-check-label">
                Read
            </label>

        </div>

    </div>


    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">

            Cancel

        </button>

        <button type="submit"
                class="btn btn-primary">

            Save Changes

        </button>

    </div>

</form>