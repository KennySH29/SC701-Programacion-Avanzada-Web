@model IEnumerable<PAW.Models.DTO.TaskDTO>
@{
    ViewData["Title"] = "Task Page";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Tasks</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Created At</th>
                            <th>Last Modified</th>
                            <th>Modified By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var task in Model)
                            {
                                <tr>
                                    <td>@task.Id</td>
                                    <td><strong>@task.Name</strong></td>
                                    <td>@task.Description</td>
                                    <td>@task.Status</td>
                                    <td>@task.DueDate?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@task.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@task.LastModified?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@task.ModifiedBy</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center">No tasks found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
