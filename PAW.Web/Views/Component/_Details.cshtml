@model PAW.Models.DTO.ComponentDTO


<div class="modal-body p-4">


    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <span class="text-muted small text-uppercase">
                Component Details
            </span>

            <h4 class="fw-bold m-0 text-primary">
                @Model.Name
            </h4>

        </div>


        <span class="badge bg-light text-dark border p-2">
            ID: #@Model.Id
        </span>

    </div>


    <div class="table-responsive bg-white rounded border p-2">

        <table class="table table-sm table-borderless align-middle m-0">

            <tbody>


                <tr>

                    <td class="text-muted">
                        Component ID
                    </td>

                    <td class="fw-semibold">
                        @Model.Id
                    </td>

                </tr>


                <tr>

                    <td class="text-muted">
                        Name
                    </td>

                    <td class="fw-semibold">
                        @Model.Name
                    </td>

                </tr>


                <tr>

                    <td class="text-muted">
                        Content
                    </td>

                    <td>
                        @Model.Content
                    </td>

                </tr>


            </tbody>

        </table>

    </div>

</div>


<div class="modal-footer">

    <button type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">
        Close
    </button>


    <button type="button"
            class="btn btn-dark btn-switch-to-edit"
            data-url="@Url.Action(
                        "Edit",
                        "Component",
                        new { id = Model.Id })">

        Edit Component

    </button>

</div>