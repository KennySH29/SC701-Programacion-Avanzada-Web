@model PAW.Models.DTO.RoleDTO

<div class="modal-body p-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <span class="text-muted small text-uppercase">
                Technical Sheet
            </span>

            <h4 class="fw-bold m-0 text-primary">
                @Model.RoleName
            </h4>
        </div>

        <span class="badge bg-light text-dark border p-2">
            ID: #@Model.RoleId
        </span>

    </div>

    <div class="table-responsive bg-white rounded border p-2">

        <table class="table table-sm table-borderless align-middle m-0">

            <tbody>

                <tr>
                    <td class="text-muted w-35">
                        Role ID
                    </td>

                    <td class="fw-semibold">
                        @Model.RoleId
                    </td>
                </tr>

                <tr>
                    <td class="text-muted">
                        Role Name
                    </td>

                    <td class="fw-semibold">
                        @Model.RoleName
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>

<div class="modal-footer">

    <button type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">
        Close
    </button>

    <button type="button"
            class="btn btn-dark btn-switch-to-edit"
            data-url="@Url.Action(
                        "Edit",
                        "Role",
                        new { id = Model.RoleId })">
        Edit Role
    </button>

</div>