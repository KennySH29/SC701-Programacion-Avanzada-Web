@model IEnumerable<PAW.Models.DTO.SupplierDTO>
@{
    ViewData["Title"] = "Supplier Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Suppliers</h2>

        <button class="btn btn-primary btn-crud" data-url="@Url.Action("Create", "Supplier")">
            <i class="bi bi-plus-circle"></i>
            Add Supplier
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Supplier ID</th>
                            <th>Supplier Name</th>
                            <th>Contact Name</th>
                            <th>Contact Title</th>
                            <th>Phone</th>
                            <th>City</th>
                            <th>Country</th>
                            <th>Modified By</th>
                            <th>Last Modified</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var supplier in Model)
                            {
                                <tr>
                                    <td>@supplier.SupplierId</td>
                                    <td><strong>@supplier.SupplierName</strong></td>
                                    <td>@supplier.ContactName</td>
                                    <td>@supplier.ContactTitle</td>
                                    <td>@supplier.Phone</td>
                                    <td>@supplier.City</td>
                                    <td>@supplier.Country</td>
                                    <td>@supplier.ModifiedBy</td>
                                    <td>@supplier.LastModified?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-sm btn-warning btn-crud"
                                                    data-url="@Url.Action("Edit", "Supplier", new { id = supplier.SupplierId })">
                                                Edit
                                            </button>
                                            <button class="btn btn-sm btn-info text-white btn-crud"
                                                    data-url="@Url.Action("Details", "Supplier", new { id = supplier.SupplierId })">
                                                Details
                                            </button>
                                            <button class="btn btn-sm btn-danger btn-crud"
                                                    data-url="@Url.Action("Delete", "Supplier", new { id = supplier.SupplierId })">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center">
                                    No suppliers found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

                @{
                    int currentPage = ViewBag.CurrentPage;
                    int totalPages = ViewBag.TotalPages;
                }

                @if (totalPages > 1)
                {
                    <nav aria-label="Supplier pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="1">First</a>
                            </li>
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                            </li>

                            <li class="page-item @(currentPage == 1 ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="1">1</a>
                            </li>

                            @if (currentPage > 3)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            @{
                                int startPage = Math.Max(2, currentPage - 1);
                                int endPage = Math.Min(totalPages - 1, currentPage + 1);
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                                </li>
                            }

                            @if (currentPage < totalPages - 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            @if (totalPages > 1)
                            {
                                <li class="page-item @(currentPage == totalPages ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@totalPages">@totalPages</a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                            </li>
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@totalPages">Last</a>
                            </li>
                        </ul>
                    </nav>
                }

            </div>

        </div>
    </div>

</div>
