@model PAW.Models.DTO.InventoryDTO

<div class="modal-body p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="text-muted small text-uppercase">Technical Sheet</span>
            <h4 class="fw-bold m-0 text-primary">Inventory</h4>
        </div>
        <span class="badge bg-light text-dark border p-2">ID: #@Model.InventoryId</span>
    </div>

    <div class="table-responsive bg-white rounded border p-2">
        <table class="table table-sm table-borderless align-middle m-0">
            <tbody>
                <tr>
                    <td class="text-muted w-35">Inventory ID</td>
                    <td class="fw-semibold">@Model.InventoryId</td>
                </tr>
                <tr>
                    <td class="text-muted">Unit Price</td>
                    <td class="fw-semibold">@Model.UnitPrice?.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="text-muted">Units in Stock</td>
                    <td class="fw-semibold">@Model.UnitsInStock</td>
                </tr>
                <tr>
                    <td class="text-muted">Product ID</td>
                    <td class="fw-semibold">
                        @if (Model.ProductId.HasValue)
                        {
                            @Model.ProductId
                        }
                        else
                        {
                            <span class="text-muted">No product ID assigned</span>
                        }
                    </td>
                </tr>
                <tr><td colspan="2"><hr class="text-muted opacity-25 my-2"></td></tr>
                <tr>
                    <td class="text-muted">Date Added</td>
                    <td class="small">@Model.DateAdded?.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
                <tr>
                    <td class="text-muted">Last Updated</td>
                    <td class="small">@Model.LastUpdated?.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
                <tr>
                    <td class="text-muted">Modified By</td>
                    <td class="small">@Model.ModifiedBy</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    <button type="button"
            class="btn btn-dark btn-switch-to-edit"
            data-url="@Url.Action("Edit", "Inventory", new { id = Model.InventoryId })">
        Edit Inventory
    </button>
</div>
