@model PAW.Models.DTO.ProductDTO
@{
    var category =
        ViewBag.Category as PAW.Models.DTO.CategoryDTO;

    var supplier =
        ViewBag.Supplier as PAW.Models.DTO.SupplierDTO;

    var inventory =
        ViewBag.Inventory as PAW.Models.DTO.InventoryDTO;
}

<div class="modal-body p-4">
    <!-- Encabezado compacto integrado dentro del cuerpo -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="text-muted small text-uppercase">Technical Sheet</span>
            <h4 class="fw-bold m-0 text-primary">@Model.Name</h4>
        </div>
        <span class="badge bg-light text-dark border p-2">ID: #@Model.ProductId</span>
    </div>

    <!-- Tabla limpia adaptable al modal -->
    <div class="table-responsive bg-white rounded border p-2">
        <table class="table table-sm table-borderless align-middle m-0">
            <tbody>
                <tr>
                    <td class="text-muted w-35">
                        Category
                    </td>

                    <td class="fw-semibold">
                        @(category?.Name ?? "No category assigned")
                    </td>
                </tr>
                <tr>
                    <td class="text-muted">Supplier</td>
                    <td class="fw-semibold">
                        @(supplier?.SupplierName ?? "No supplier assigned")
                    </td>
                </tr>
                <tr>
                    <td class="text-muted">
                        Units in Stock
                    </td>

                    <td class="fw-semibold">
                        @(inventory?.UnitsInStock?.ToString()
                            ?? "No inventory assigned")
                    </td>
                </tr>

                <tr>
                    <td class="text-muted">
                        Unit Price
                    </td>

                    <td class="fw-semibold">
                        @(inventory?.UnitPrice?.ToString("N2")
                            ?? "N/A")
                    </td>
                </tr>
                <tr>
                    <td class="text-muted">Rating</td>
                    <td class="text-warning fw-bold">★ @Model.Rating / 5</td>
                </tr>

                <tr><td colspan="2"><hr class="text-muted opacity-25 my-2"></td></tr>

                <tr>
                    <td class="text-muted">Description</td>
                    <td class="text-secondary text-wrap">@Model.Description</td>
                </tr>

                <tr><td colspan="2"><hr class="text-muted opacity-25 my-2"></td></tr>

                <tr>
                    <td class="text-muted">Created By</td>
                    <td class="small">@Model.CreatedBy <span class="text-muted">(@Model.CreatedDate)</span></td>
                </tr>
                <tr>
                    <td class="text-muted">Modified By</td>
                    <td class="small">@Model.ModifiedBy <span class="text-muted">(@Model.ModifiedDate)</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal-footer">
    <button asp-action="Index" type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    <!-- Mantenemos la opción de saltar a Editar desde aquí si lo necesitas, pasándole el ID -->
    <button type="button"
            class="btn btn-dark btn-switch-to-edit"
            data-url="@Url.Action("Edit", "Product", new { id = Model.ProductId })">
        Edit Product
    </button>
</div>