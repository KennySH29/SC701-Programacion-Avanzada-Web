@model PAW.Models.DTO.NotificationDTO

<div class="modal-body p-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <span class="text-muted small text-uppercase">
                Notification Details
            </span>

            <h4 class="fw-bold m-0 text-primary">
                Notification #@Model.Id
            </h4>

        </div>


        @if (Model.IsRead == true)
        {
            <span class="badge bg-success p-2">
                Read
            </span>
        }
        else
        {
            <span class="badge bg-warning text-dark p-2">
                Unread
            </span>
        }

    </div>


    <div class="table-responsive bg-white rounded border p-2">

        <table class="table table-sm table-borderless align-middle m-0">

            <tbody>

                <tr>

                    <td class="text-muted">
                        Notification ID
                    </td>

                    <td class="fw-semibold">
                        @Model.Id
                    </td>

                </tr>


                <tr>

                    <td class="text-muted">
                        User ID
                    </td>

                    <td class="fw-semibold">
                        @Model.UserId
                    </td>

                </tr>


                <tr>

                    <td class="text-muted">
                        Message
                    </td>

                    <td>
                        @Model.Message
                    </td>

                </tr>


                <tr>

                    <td class="text-muted">
                        Status
                    </td>

                    <td>

                        @if (Model.IsRead == true)
                        {
                            <span class="badge bg-success">
                                Read
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Unread
                            </span>
                        }

                    </td>

                </tr>


                <tr>

                    <td class="text-muted">
                        Created At
                    </td>

                    <td>
                        @Model.CreatedAt?.ToString(
                            "yyyy-MM-dd HH:mm")
                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</div>


<div class="modal-footer">

    <button type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">

        Close

    </button>


    <button type="button"
            class="btn btn-dark btn-switch-to-edit"
            data-url="@Url.Action(
                        "Edit",
                        "Notification",
                        new { id = Model.Id })">

        Edit Notification

    </button>

</div>