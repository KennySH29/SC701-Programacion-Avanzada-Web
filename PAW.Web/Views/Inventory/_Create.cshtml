@model PAW.Models.DTO.InventoryDTO

<form asp-action="Create" method="post" id="formCreateInventory">
    @Html.AntiForgeryToken()

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="UnitPrice" class="form-label"></label>
            <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="UnitPrice" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="UnitsInStock" class="form-label"></label>
            <input asp-for="UnitsInStock" type="number" class="form-control" />
            <span asp-validation-for="UnitsInStock" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ProductId" class="form-label"></label>
            <input asp-for="ProductId" type="number" class="form-control" placeholder="Optional" />
            <span asp-validation-for="ProductId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ModifiedBy" class="form-label"></label>
            <input asp-for="ModifiedBy" class="form-control" />
            <span asp-validation-for="ModifiedBy" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>
