@model IEnumerable<PAW.Models.DTO.RoleDTO>

@{
    ViewData["Title"] = "Role Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Roles</h2>

        <button class="btn btn-primary btn-crud"
                data-url="@Url.Action("Create", "Role")">

            <i class="bi bi-plus-circle"></i>

            Add Role

        </button>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Role ID</th>
                            <th>Role Name</th>
                            <th class="text-center">
                                Actions
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var role in Model)
                            {
                                <tr>

                                    <td>
                                        @role.RoleId
                                    </td>

                                    <td>
                                        <strong>
                                            @role.RoleName
                                        </strong>
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group"
                                             role="group">

                                            <button class="btn btn-sm btn-warning btn-crud"
                                                    data-url="@Url.Action(
                                                                                                        "Edit",
                                                                                                        "Role",
                                                                                                        new { id = role.RoleId })">

                                                Edit

                                            </button>

                                            <button class="btn btn-sm btn-info text-white btn-crud"
                                                    data-url="@Url.Action(
                                                                                                        "Details",
                                                                                                        "Role",
                                                                                                        new { id = role.RoleId })">

                                                Details

                                            </button>

                                            <button class="btn btn-sm btn-danger btn-crud"
                                                    data-url="@Url.Action(
                                                                                                        "Delete",
                                                                                                        "Role",
                                                                                                        new { id = role.RoleId })">

                                                Delete

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="3"
                                    class="text-center">

                                    No roles found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>


                @{
                    int currentPage = ViewBag.CurrentPage;
                    int totalPages = ViewBag.TotalPages;
                }


                @if (totalPages > 1)
                {
                    <nav aria-label="Role pagination">

                        <ul class="pagination justify-content-center">

                            <!-- FIRST -->
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="1">

                                    First

                                </a>

                            </li>


                            <!-- PREVIOUS -->
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage - 1)">

                                    Previous

                                </a>

                            </li>


                            <!-- FIRST PAGE -->
                            <li class="page-item @(currentPage == 1 ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="1">

                                    1

                                </a>

                            </li>


                            <!-- LEFT ELLIPSIS -->
                            @if (currentPage > 3)
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        ...
                                    </span>

                                </li>
                            }


                            @{
                                int startPage =
                                    Math.Max(
                                        2,
                                        currentPage - 1);

                                int endPage =
                                    Math.Min(
                                        totalPages - 1,
                                        currentPage + 1);
                            }


                            <!-- PREVIOUS / CURRENT / NEXT PAGE -->
                            @for (int i = startPage;
                                 i <= endPage;
                                 i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i">

                                        @i

                                    </a>

                                </li>
                            }


                            <!-- RIGHT ELLIPSIS -->
                            @if (currentPage < totalPages - 2)
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        ...
                                    </span>

                                </li>
                            }


                            <!-- LAST PAGE -->
                            @if (totalPages > 1)
                            {
                                <li class="page-item @(currentPage == totalPages ? "active" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@totalPages">

                                        @totalPages

                                    </a>

                                </li>
                            }


                            <!-- NEXT -->
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage + 1)">

                                    Next

                                </a>

                            </li>


                            <!-- LAST -->
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@totalPages">

                                    Last

                                </a>

                            </li>

                        </ul>

                    </nav>
                }

            </div>

        </div>

    </div>

</div>